{
  "name": "developerawam/livewire-datatable",
  "description": "Laravel Livewire DataTable — package open-source untuk membangun tabel dinamis di Laravel dengan fitur search, filter, sorting, pagination, export, row selection, multi-sort, dan integrasi Blaze.",
  "keywords": [
    "developerawam",
    "livewire-datatable",
    "laravel",
    "livewire",
    "datatable"
  ],
  "homepage": "https://github.com/developerawam/livewire-datatable",
  "license": "MIT",
  "type": "library",
  "version": "3.0.0",
  "authors": [
    {
      "name": "Developer Awam",
      "email": "info@developerawam.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0||^13.0",
    "livewire/livewire": "^4.0",
    "maatwebsite/excel": "^3.1",
    "barryvdh/laravel-dompdf": "^3.1"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0||^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "suggest": {
    "livewire/blaze": "^1.0 — Pre-compile Blade templates for 91-97% rendering overhead reduction."
  },
  "autoload": {
    "psr-4": {
      "Developerawam\\LivewireDatatable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Developerawam\\LivewireDatatable\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Developerawam\\LivewireDatatable\\LivewireDatatableServiceProvider"
      ],
      "aliases": {
        "LivewireDatatable": "Developerawam\\LivewireDatatable\\LivewireDatatableFacade"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
